# Copy this file to secrets.toml and fill in your values.

# —— Refresh from online sheet (optional) ——
# Add [gsheet_service_account] with the full service account JSON so "Refresh from online sheet" works.
# In Google Cloud: create a service account → Keys → Add key (JSON) → download. Share the Sheet with client_email (Viewer).
# See docs/REFRESH_FROM_ONLINE_SHEET.md.
# [gsheet_service_account]
# type = "service_account"
# project_id = "your-project"
# private_key_id = "..."
# private_key = "-----BEGIN PRIVATE KEY-----\n...\n-----END PRIVATE KEY-----\n"
# client_email = "xxx@your-project.iam.gserviceaccount.com"
# client_id = "..."
# auth_uri = "https://accounts.google.com/o/oauth2/auth"
# token_uri = "https://oauth2.googleapis.com/token"
# auth_provider_x509_cert_url = "https://www.googleapis.com/oauth2/v1/certs"
# client_x509_cert_url = "https://www.googleapis.com/robot/v1/metadata/x509/..."

# Developer access: only someone who knows this key can upload, refresh, or edit tracker source.
# Unlock via sidebar > Developer access. Developers can also manage the allowed-users list.
DEVELOPER_KEY = "your-secret-key"

# Optional: limit app access to specific users (allowlist). Set to true to enable.
# When enabled, only users in the allowlist (or developers with the key above) can use the app.
# Add/remove users under Developer access > Allowed users.
# ALLOWLIST_ENABLED = false

# Optional: load tracker data from GitHub instead of manual upload.
# Use the raw file URL (e.g. https://raw.githubusercontent.com/username/repo/main/data/output/ksa_kitchen_tracker.csv).
# Then in the app use "Load from GitHub" under Data to pull the latest file.
# GITHUB_TRACKER_CSV_URL = "https://raw.githubusercontent.com/maisam21-lab/ksa-kitchenP-tracker/main/data/output/ksa_kitchen_tracker.csv"

# AI (optional). Uncomment and set your key so "Ask AI" works (uses GPT-4o-mini).
# Get a key at https://platform.openai.com/api-keys
# OPENAI_API_KEY = "sk-your-key-here"

# Salesforce: Use Report IDs (needs Run Reports permission) OR SOQL (no report permission). See docs/SETUP_SF_SECRETS.md and docs/SECRETS_SOQL_PASTE.md
# Data provider: mock (local JSON/CSV in app/data/mock), sandbox, or prod. Default: prod. See docs/SFDC_PROVIDERS.md
# SFDC_PROVIDER = "mock"
# [sf_tab_queries]
# Report IDs (replace with your report IDs; 403? use SOQL — see docs/SECRETS_SOQL_PASTE.md):
# "Kitchens" = "00OVO00000PMnq92AD"
# "SF Kitchen Data" = "00O6T000006Y0l6UAC"
# "SF Churn Data" = "00O6T000006Y5DiUAK"
# "Sellable No Status" = "00O6T000006DXT0UAO"
# "All no status kitchens" = "00O6T000006DPigUAG"
# "Price Multipliers" = "00OVO000003z2O92AI"
# "Area Data" = "00O6T000006Y0l6UAC"
# SOQL (copy from docs/SECRETS_SOQL_PASTE.md to avoid 403):
# "SF Kitchen Data" = "SELECT Id, Name, Kitchen_Number_ID_18__c, Type__c, Category__c, Status__c, Account__r.Name, Account__r.Country__c FROM Kitchen_Number__c WHERE Account__r.Country__c IN ('Saudi Arabia', 'UAE', 'Kuwait', 'Bahrain', 'Qatar') ORDER BY Account__r.Country__c, Account__r.Name, Name"
# "SF Churn Data" = "SELECT Account__r.Name, Type__c, Category__c, Kitchen_Number_ID_18__c, Name, Status__c, Kitchen_Size_Sq_Meters__c, Hood_Size__c, Floor_Price__c, MSRP__c, Activation_Fee__c, Opportunity__r.Id, Opportunity__r.Name, Opportunity__r.Owner.Name, Opportunity__r.Floor__c, Opportunity__r.Churn_Date__c FROM Kitchen_Number__c WHERE Status__c = 'Churning' AND Account__r.Country__c IN ('Saudi Arabia', 'UAE', 'Kuwait', 'Bahrain', 'Qatar') ORDER BY Account__r.Country__c, Account__r.Name, Name"

# Trino (optional). Get the host from your Superset/Beam Trino connection.
TRINO_HOST = "your-trino-host.com"
TRINO_PORT = 443
TRINO_CATALOG = "google_spreadsheets"
TRINO_USER = "trino"
